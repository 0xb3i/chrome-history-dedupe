{
  "manifest_version": 3,
  "name": "历史记录去重搜索",
  "version": "1.11.11",
  "minimum_chrome_version": "105",
  "incognito": "not_allowed",
  "description": "搜索 Chrome 历史记录，并自动合并同一页面的重复 URL 与子标签页。",
  "icons": {
    "16": "icons/cat-16.png",
    "32": "icons/cat-32.png",
    "48": "icons/cat-48.png",
    "128": "icons/cat-128.png"
  },
  "permissions": [
    "favicon",
    "activeTab",
    "history",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Deduped History Search",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cat-16.png",
      "32": "icons/cat-32.png",
      "48": "icons/cat-48.png",
      "128": "icons/cat-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Option+S"
      }
    },
    "rename-current-page": {
      "description": "Rename the current page for deduped history search.",
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Option+Shift+S"
      }
    }
  }
}
